{
  "name": "@ineed-linklab/electron",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "vite build",
    "dev": "concurrently -k \"vite --host 127.0.0.1 --port 5173 --strictPort\" \"wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 node ../../scripts/dev-electron.mjs .\"",
    "package:mac:arm64": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg --arm64 --config.directories.output=release/arm64",
    "package:mac:x64": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg --x64 --config.directories.output=release/x64"
  },
  "dependencies": {
    "@ineed-linklab/codecs": "*",
    "@ineed-linklab/persistence-contract": "*",
    "modbus-serial": "8.0.25",
    "node-opcua": "2.187.10",
    "serialport": "^13.0.0",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@electron/asar": "4.2.0",
    "@ineed-linklab/runtime-contract": "*",
    "@ineed-linklab/workbench": "*",
    "@vitejs/plugin-vue": "^6.0.6",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^43.1.0",
    "electron-builder": "26.15.3",
    "vite": "^8.1.4",
    "vue": "^3.5.39",
    "wait-on": "^9.0.10"
  },
  "description": "Multi-protocol communication debugging assistant",
  "homepage": "https://www.ineedfull.com/"
}
